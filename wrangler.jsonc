// Cloudflare Workers 部署配置
// 首次部署：npx wrangler@4.144.0 deploy        （会自动创建名为 todos 的 D1 数据库并关联，之后的部署自动沿用）
// 设置密码：npx wrangler@4.144.0 secret put TODOS_PASSWORD
{
  "name": "todos",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 所有请求先进 Worker：页面要先检查登录、统一加安全响应头
    "run_worker_first": true,
    // 保持 /board.html 这样的地址，不自动改写成 /board（和 Node 版一致）
    "html_handling": "none",
    "not_found_handling": "none"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "todos" }
  ],

  "observability": { "enabled": true }
}
