{
  "name": "todos",
  "version": "1.0.0",
  "private": true,
  "description": "日历 + 便利贴的待办清单。零依赖 Node 服务（SQLite），也可以部署到 Cloudflare Workers（D1）。",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=server server/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "cf:dev": "npx wrangler@4.144.0 dev",
    "cf:deploy": "npx wrangler@4.144.0 deploy"
  }
}
