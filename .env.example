# 复制为 .env 后按需修改（docker compose 会自动读取）

# 访问密码。公网部署务必设置；不设则任何人都能读写。
TODOS_PASSWORD=

# 对外端口（docker compose 用）
PORT=8080

# 在 Nginx / Caddy 等反向代理后面时设为 1，用 X-Forwarded-For 识别客户端 IP（登录限流用）
TRUST_PROXY=0

# 会话签名密钥，可不填（首次启动自动生成并存进数据库）
# SESSION_SECRET=

# 强制开关 Cookie 的 Secure 标记；不填则按请求是否 HTTPS 自动判断
# COOKIE_SECURE=1
